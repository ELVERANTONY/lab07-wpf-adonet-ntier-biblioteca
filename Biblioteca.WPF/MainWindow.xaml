<Window x:Class="Biblioteca.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BibliotecaDB | Gestión de biblioteca" Height="780" Width="1240"
        MinHeight="650" MinWidth="980" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#0F766E"/><SolidColorBrush x:Key="PrimaryHover" Color="#0B5F59"/>
        <SolidColorBrush x:Key="Ink" Color="#172033"/><SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="Canvas" Color="#F5F7FB"/><SolidColorBrush x:Key="Line" Color="#E2E8F0"/>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/></Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="4,0,4,4"/></Style>
        <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="14,8"/><Setter Property="MinHeight" Value="34"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#334155"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Primary}"/><Setter Property="Foreground" Value="White"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryHover}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Opacity" Value=".55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#FEF2F2"/><Setter Property="Foreground" Value="#DC2626"/></Style>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="9,7"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="7"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5E1"/></Style>
        <Style TargetType="DatePicker"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="5"/></Style>
        <Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeight" Value="42"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="AlternatingRowBackground" Value="#F8FAFC"/><Setter Property="SelectionMode" Value="Single"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F8FAFC"/><Setter Property="Foreground" Value="#475569"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="Padding" Value="12,4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="TabItem"><Setter Property="Foreground" Value="#64748B"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="17,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="tab" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="tab" Property="Foreground" Value="{StaticResource Primary}"/><Setter TargetName="tab" Property="BorderBrush" Value="{StaticResource Primary}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="tab" Property="Foreground" Value="{StaticResource Ink}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <DockPanel Background="{StaticResource Canvas}">
        <Border DockPanel.Dock="Top" Background="#115E59" Padding="28,17"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Background="#0F8F83" CornerRadius="10" Width="42" Height="42" Margin="0,0,13,0"><TextBlock Text="B" FontSize="23" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="BibliotecaDB" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock Text="Panel de administración y préstamos" Foreground="#CCFBF1" FontSize="12"/></StackPanel></StackPanel><Border Grid.Column="1" Background="#0B4F4A" CornerRadius="14" Padding="13,7" VerticalAlignment="Center"><TextBlock Text="●  Sistema conectado" Foreground="#CCFBF1" FontSize="12"/></Border></Grid></Border>
        <TabControl x:Name="MainTabs" Margin="24,18,24,24" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Libros"><Grid Margin="2,16,2,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="2,0,2,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Catálogo de libros" Style="{StaticResource SectionTitle}"/><TextBlock Text="Consulta y administra el inventario disponible." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBox x:Name="TxtBuscarLibro" Width="265" ToolTip="Buscar por título o autor"/><Button Content="⌕  Buscar" Click="BuscarLibros_Click"/><Button Content="↻" ToolTip="Mostrar todos" Click="RefrescarLibros_Click"/></StackPanel></Grid><Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="2"><DataGrid x:Name="GridLibros" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="GridLibros_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding LibroId}" Width="65"/><DataGridTextColumn Header="TÍTULO" Binding="{Binding Titulo}" Width="*"/><DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="180"/><DataGridTextColumn Header="AUTOR" Binding="{Binding NombreAutor}" Width="190"/><DataGridTextColumn Header="STOCK" Binding="{Binding Ejemplares}" Width="85"/></DataGrid.Columns></DataGrid></Border><Border Grid.Row="2" Style="{StaticResource Card}" Margin="2,16,2,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TÍTULO" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtLibroTitulo"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="ISBN" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtLibroIsbn"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="AUTOR" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="CboAutor" DisplayMemberPath="Nombre" SelectedValuePath="AutorId"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="EJEMPLARES" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtLibroEjemplares" Width="92"/><WrapPanel HorizontalAlignment="Right"><Button Content="Nuevo" Click="NuevoLibro_Click"/><Button Content="Guardar" Style="{StaticResource PrimaryButton}" Click="GuardarLibro_Click"/><Button Content="Dar de baja" Style="{StaticResource DangerButton}" Click="EliminarLibro_Click"/></WrapPanel></StackPanel></Grid></Border></Grid></TabItem>
            <TabItem Header="Socios"><Grid Margin="2,16,2,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="2,0,2,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Socios registrados" Style="{StaticResource SectionTitle}"/><TextBlock Text="Administra los datos de los miembros de la biblioteca." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBox x:Name="TxtBuscarSocio" Width="265" ToolTip="Buscar por nombre o DNI"/><Button Content="⌕  Buscar" Click="BuscarSocios_Click"/><Button Content="↻" ToolTip="Mostrar todos" Click="RefrescarSocios_Click"/></StackPanel></Grid><Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="2"><DataGrid x:Name="GridSocios" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="GridSocios_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding SocioId}" Width="65"/><DataGridTextColumn Header="DNI" Binding="{Binding DNI}" Width="140"/><DataGridTextColumn Header="NOMBRE COMPLETO" Binding="{Binding Nombre}" Width="*"/><DataGridTextColumn Header="CORREO ELECTRÓNICO" Binding="{Binding Email}" Width="290"/></DataGrid.Columns></DataGrid></Border><Border Grid.Row="2" Style="{StaticResource Card}" Margin="2,16,2,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DNI" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtSocioDni"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="NOMBRE" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtSocioNombre"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtSocioEmail"/></StackPanel><WrapPanel Grid.Column="3" VerticalAlignment="Center"><Button Content="Nuevo" Click="NuevoSocio_Click"/><Button Content="Guardar" Style="{StaticResource PrimaryButton}" Click="GuardarSocio_Click"/><Button Content="Dar de baja" Style="{StaticResource DangerButton}" Click="EliminarSocio_Click"/></WrapPanel></Grid></Border></Grid></TabItem>
            <TabItem Header="Préstamos"><Grid Margin="2,16,2,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Style="{StaticResource Card}" Margin="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Nuevo préstamo" Style="{StaticResource SectionTitle}"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="Socio" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/><ComboBox x:Name="CboSocioPrestamo" Width="300" DisplayMemberPath="Nombre" SelectedValuePath="SocioId"/><TextBlock Text="Fecha límite" Style="{StaticResource FieldLabel}" Margin="18,0,0,4" VerticalAlignment="Center"/><DatePicker x:Name="FechaLimitePrestamo" Width="150"/></StackPanel></StackPanel><Border Grid.Column="1" Background="#ECFDF5" CornerRadius="8" Padding="12" VerticalAlignment="Center"><TextBlock Text="Selecciona uno o varios libros y confírmalos al final." TextWrapping="Wrap" Foreground="#065F46" FontSize="12"/></Border></Grid></Border><Grid Grid.Row="1" Margin="2,13"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="112"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="  Libros disponibles" Style="{StaticResource SectionTitle}" Margin="10"/><DataGrid x:Name="GridLibrosDisponibles" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"><DataGrid.Columns><DataGridTextColumn Header="TÍTULO" Binding="{Binding Titulo}" Width="*"/><DataGridTextColumn Header="AUTOR" Binding="{Binding NombreAutor}" Width="145"/><DataGridTextColumn Header="STOCK" Binding="{Binding Ejemplares}" Width="65"/></DataGrid.Columns></DataGrid></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"><Button Content="Agregar  →" Style="{StaticResource PrimaryButton}" Click="AgregarLibroPrestamo_Click"/><Button Content="←  Quitar" Click="QuitarLibroPrestamo_Click"/></StackPanel><Border Grid.Column="2" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="  Selección del préstamo" Style="{StaticResource SectionTitle}" Margin="10"/><DataGrid x:Name="GridDetallePrestamo" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"><DataGrid.Columns><DataGridTextColumn Header="TÍTULO" Binding="{Binding Titulo}" Width="*"/><DataGridTextColumn Header="AUTOR" Binding="{Binding NombreAutor}" Width="145"/></DataGrid.Columns></DataGrid></Grid></Border></Grid><Border Grid.Row="2" Style="{StaticResource Card}" Margin="2,13,2,2" Padding="12"><DockPanel><TextBlock x:Name="TxtTotalPrestamo" Text="0 libro(s) seleccionado(s)" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Registrar préstamo" Style="{StaticResource PrimaryButton}" Click="RegistrarPrestamo_Click"/></DockPanel></Border></Grid></TabItem>
            <TabItem Header="Devoluciones"><Grid Margin="2,16,2,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Style="{StaticResource Card}" Margin="2"><DockPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Devoluciones pendientes" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,18,0"/><TextBlock Text="Socio" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/><ComboBox x:Name="CboSocioDevolucion" Width="290" DisplayMemberPath="Nombre" SelectedValuePath="SocioId" SelectionChanged="CboSocioDevolucion_SelectionChanged"/><Button Content="Actualizar" Click="RefrescarDevoluciones_Click"/></StackPanel><TextBlock DockPanel.Dock="Right" Text="La multa se calcula al confirmar" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12"/></DockPanel></Border><Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="2,13"><DataGrid x:Name="GridDevoluciones" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="PRÉSTAMO" Binding="{Binding PrestamoId}" Width="110"/><DataGridTextColumn Header="LIBRO" Binding="{Binding NombreLibro}" Width="*"/><DataGridTextColumn Header="FECHA LÍMITE" Binding="{Binding FechaLimite, StringFormat=d}" Width="160"/></DataGrid.Columns></DataGrid></Border><Border Grid.Row="2" Style="{StaticResource Card}" Margin="2,0,2,2" Padding="12"><DockPanel><TextBlock Text="Selecciona un libro pendiente para procesar la devolución." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Registrar devolución" Style="{StaticResource PrimaryButton}" Click="RegistrarDevolucion_Click"/></DockPanel></Border></Grid></TabItem>
            <TabItem Header="Reportes"><Grid Margin="2,16,2,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}" Margin="2"><StackPanel Orientation="Horizontal"><StackPanel Margin="0,0,20,0"><TextBlock Text="Historial de préstamos" Style="{StaticResource SectionTitle}"/><TextBlock Text="Filtra las operaciones por fecha." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel><TextBlock Text="Desde" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/><DatePicker x:Name="FechaReporteInicio" Width="140"/><TextBlock Text="Hasta" Style="{StaticResource FieldLabel}" Margin="14,0,0,4" VerticalAlignment="Center"/><DatePicker x:Name="FechaReporteFin" Width="140"/><Button Content="Generar reporte" Style="{StaticResource PrimaryButton}" Click="GenerarReporte_Click"/></StackPanel></Border><Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="2,13,2,2"><DataGrid x:Name="GridReporte" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="PRÉSTAMO" Binding="{Binding PrestamoId}" Width="90"/><DataGridTextColumn Header="SOCIO" Binding="{Binding NombreSocio}" Width="175"/><DataGridTextColumn Header="DNI" Binding="{Binding DniSocio}" Width="105"/><DataGridTextColumn Header="LIBROS" Binding="{Binding Libros}" Width="*"/><DataGridTextColumn Header="PRESTADO" Binding="{Binding FechaPrestamo, StringFormat=d}" Width="115"/><DataGridTextColumn Header="LÍMITE" Binding="{Binding FechaLimite, StringFormat=d}" Width="115"/><DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="105"/></DataGrid.Columns></DataGrid></Border></Grid></TabItem>
        </TabControl>
    </DockPanel>
</Window>
