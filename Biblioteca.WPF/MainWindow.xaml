<Window x:Class="Biblioteca.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biblioteca" Height="360" Width="640"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F8FAFC">
        <Border Margin="32" Padding="28" Background="White" CornerRadius="12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Sistema de Biblioteca" FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock Margin="0,12,0,0" FontSize="16" Foreground="#475569"
                           Text="Proyecto WPF iniciado correctamente." />
                <TextBlock Margin="0,8,0,0" Foreground="#64748B" TextWrapping="Wrap"
                           Text="Aquí se agregarán las pantallas de socios, libros y préstamos." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
